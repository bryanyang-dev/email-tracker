# Copy this file to .env in the repository root for local development.
# Never put real credentials in this tracked template.

# Google Cloud Desktop OAuth client credentials.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Optional Ollama settings; the endpoint must remain on literal loopback.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_AUTO_START=true
# Optional when exactly one model is installed; required to choose among multiple models.
OLLAMA_MODEL=
# Optional absolute directory for the local workspace database.
# APP_DATA_DIR="/Users/you/Library/Application Support/Local Email Workspace"
